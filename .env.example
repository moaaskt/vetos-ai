# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://vetos:vetospassword@localhost:5432/vetos?schema=public"

# Authentication & Security
JWT_SECRET="your-super-secret-jwt-key"
TUTOR_JWT_SECRET="your-super-secret-tutor-jwt-key"
ENCRYPTION_KEY="your-32-byte-encryption-key-for-credentials"

# Server & Networking
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
PUBLIC_APP_URL="http://localhost:5173"

# Redis & Queue Engine (BullMQ)
REDIS_HOST="localhost"
REDIS_PORT=6379

# Multi-tenancy Mode (OFF | LOG | ENFORCE)
TENANT_EXTENSION_MODE="ENFORCE"
